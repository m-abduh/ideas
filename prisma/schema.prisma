generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "sqlite"
}

model Idea {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  sourceUrl   String   @unique
  references  String   @default("[]")
  prd         String   @default("")
  saved       Boolean  @default(false)
  createdAt   DateTime @default(now())
}
